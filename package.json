{
  "license": "MIT",
  "name": "iori",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "check:docs": "node docs/check-links.mjs --self-test && node docs/check-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm -r check && tsc --project e2e/ui/tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "tauri": "pnpm --filter @iori/client tauri",
    "release:build": "node scripts/release/build.mjs",
    "e2e:ui": "node node_modules/@playwright/test/cli.js test --config=e2e/ui/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "cmd-shim": "9.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.2",
    "github-slugger": "2.0.0",
    "prettier": "3.9.9",
    "remark-parse": "11.0.0",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "unified": "11.0.5",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  }
}
