<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="iori_identity.xml" />
        <exclude domain="root" path="registrations.sqlite3" />
        <exclude domain="root" path="registrations.sqlite3-journal" />
        <exclude domain="root" path="registrations.sqlite3-wal" />
        <exclude domain="root" path="registrations.sqlite3-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="iori_identity.xml" />
        <exclude domain="root" path="registrations.sqlite3" />
        <exclude domain="root" path="registrations.sqlite3-journal" />
        <exclude domain="root" path="registrations.sqlite3-wal" />
        <exclude domain="root" path="registrations.sqlite3-shm" />
    </device-transfer>
</data-extraction-rules>
