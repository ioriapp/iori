[Unit]
Description=iori external CLI compatibility monitor

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/iori-cli-compat/repo
EnvironmentFile=%h/.config/iori/cli-compat.env
UnsetEnvironment=CLAUDECODE CLAUDE_CODE_ENTRYPOINT
Nice=19
MemoryMax=4G
MemorySwapMax=0
ExecStartPre=/usr/bin/env node scripts/cli-compat/prepare.mjs
ExecStart=/usr/bin/env node scripts/run-bounded-check.mjs --memory-only node scripts/cli-compat.mjs
